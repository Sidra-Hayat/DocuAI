<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Shown while the process starts, when the OS's Dark Mode setting is off.

      The splash is one mechanism expressed two ways, not two mechanisms. Below
      Android 12 the window background *is* the splash, and it is
      `@drawable/launch_background`. From Android 12 the platform composes its
      own and ignores that drawable, so values-v31 restates the same ink and the
      same mark in the attributes the platform reads. Both paths draw the same
      two things; neither is a fallback pretending to be the other.

      Flutter removes this theme as soon as the engine paints its first frame —
      see the NormalTheme meta-data in AndroidManifest.xml. Nothing here holds
      the app open for longer than it takes to start.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
