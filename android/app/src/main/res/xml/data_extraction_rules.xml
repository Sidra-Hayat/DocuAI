<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above (android:dataExtractionRules).

  Covers both transports separately, because they are separate decisions:

  * cloud-backup — Google Drive. Excluded for the same reason as
    backup_rules.xml: scanned documents and their recognised text must not
    leave the device.
  * device-transfer — direct phone-to-phone migration. Also excluded. It never
    touches Google's servers, so it is a weaker risk, but a document scanner
    holding passports and bank statements should move only when the user
    deliberately exports, not as a side effect of setting up a new handset.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
