# Normalise line endings so the repo stays consistent across Windows and CI.
* text=auto eol=lf

# Gradle wrapper scripts must keep their platform-native endings.
gradlew          text eol=lf
gradlew.bat      text eol=crlf

# Binary assets — never diff or normalise these.
*.png            binary
*.jpg            binary
*.jpeg           binary
*.webp           binary
*.ttf            binary
*.otf            binary
*.jar            binary
*.keystore       binary
*.jks            binary

# Generated Dart sources: collapse diff noise in reviews but keep them tracked.
*.g.dart         linguist-generated=true -diff
*.freezed.dart   linguist-generated=true -diff
